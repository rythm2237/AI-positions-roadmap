# Supabase server-side configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Public, RLS-limited key used only to read published Career content.
SUPABASE_ANON_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Resend server-side configuration
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=AI Career OS <hello@example.com>

# AI Gateway — server-side project evidence reviewer
# Vercel may provision gateway auth for deployments; set this explicitly for local/non-Vercel execution.
AI_GATEWAY_API_KEY=
PROJECT_REVIEW_MODEL=openai/gpt-4.1
INTERVIEW_REVIEW_MODEL=openai/gpt-4.1
# Free Public Beta cost controls. Limits are enforced server-side per authenticated user, per UTC day.
BETA_PROJECT_REVIEW_DAILY_LIMIT=10
BETA_INTERVIEW_REVIEW_DAILY_LIMIT=10

# Stripe Billing — server-side only
# Approved commercial pricing: Pro Monthly €19.90/month; Pro Annual €179/year.
# Billing infrastructure stays deployed during the Free Public Beta, but checkout is disabled unless this flag is explicitly true.
NEXT_PUBLIC_ROLE_PATH_BILLING_ENABLED=false
# Do not expose Stripe secret/price/webhook values through NEXT_PUBLIC_* variables.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_ROLE_PATH_PRO_MONTHLY_PRICE_ID=price_replace_me
STRIPE_ROLE_PATH_PRO_ANNUAL_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public commercial/legal identity.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Tayyebialashti Yaser e.v.
NEXT_PUBLIC_TRADING_NAME=AI Career OS
NEXT_PUBLIC_REGISTERED_ADDRESS=1143 Budapest, Gizella út 35, Hungary
NEXT_PUBLIC_COMPANY_REGISTRATION_NUMBER=58642889
NEXT_PUBLIC_VAT_NUMBER=48332376-1-42
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=career-legal@rythm-os.com
NEXT_PUBLIC_SUPPORT_EMAIL=career-support@rythm-os.com
NEXT_PUBLIC_BILLING_EMAIL=career-billing@rythm-os.com
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_COMPLAINT_ADDRESS=1143 Budapest, Gizella út 35, Hungary
NEXT_PUBLIC_DISPUTE_RESOLUTION_BODY=Budapesti Békéltető Testület (Budapest Conciliation Board)
NEXT_PUBLIC_DISPUTE_RESOLUTION_ADDRESS=1016 Budapest, Krisztina krt. 99. I. em. 111., Hungary
NEXT_PUBLIC_DISPUTE_RESOLUTION_POSTAL_ADDRESS=1253 Budapest, Pf. 10., Hungary
NEXT_PUBLIC_DISPUTE_RESOLUTION_EMAIL=bekelteto.testulet@bkik.hu
NEXT_PUBLIC_DISPUTE_RESOLUTION_PHONE=+36 1 488 2131
NEXT_PUBLIC_DISPUTE_RESOLUTION_URL=https://bekeltet.bkik.hu/elerhetosegek

# Public site / consent-controlled analytics
# The canonical production origin is https://www.airolepath.com.
NEXT_PUBLIC_SITE_URL=https://www.airolepath.com
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Job Agent multi-source discovery. Keep `legacy` during rollout, then use `shadow`, then `primary`.
JOB_DISCOVERY_V2_MODE=legacy
JOB_PROVIDER_DIRECT_ENABLED=true
JOB_PROVIDER_APIFY_ENABLED=false
JOB_PROVIDER_SERPAPI_ENABLED=true
JOB_PROVIDER_ADZUNA_ENABLED=true
JOB_PROVIDER_GREENHOUSE_PRIORITY=10
JOB_PROVIDER_LEVER_PRIORITY=11
JOB_PROVIDER_ADZUNA_PRIORITY=30
JOB_PROVIDER_SERPAPI_PRIORITY=100
JOB_DISCOVERY_MIN_RESULTS_BEFORE_FALLBACK=20
JOB_DISCOVERY_MAX_RESULTS_PER_PROVIDER=25
JOB_DISCOVERY_MAX_REQUESTS=36
JOB_DISCOVERY_MAX_APIFY_RUNS=2
# Per-user UTC-day guard. Zero/blank disables the daily cap; per-run maxChargeUsd still applies.
JOB_DISCOVERY_APIFY_DAILY_BUDGET_USD=
JOB_DISCOVERY_REQUEST_TIMEOUT_MS=15000
JOB_DISCOVERY_GATEWAY_DEADLINE_MS=120000
JOB_DISCOVERY_APIFY_TIMEOUT_MS=45000
JOB_DISCOVERY_MIN_INTERVAL_SECONDS=30
JOB_DISCOVERY_SCHEDULED_ENABLED=false
JOB_DISCOVERY_SCHEDULED_MAX_USERS=2
# Server-only credential. Actor IDs are accepted only from the allowlisted JSON configuration below.
APIFY_API_TOKEN=
# Example public LinkedIn discovery Actor configuration. Actor input keys vary, so map them with a server-side template.
# JOB_DISCOVERY_APIFY_ACTORS=[{"source":"linkedin","actorId":"approved-owner~approved-actor","enabled":true,"priority":20,"maxResults":25,"maxChargeUsd":1,"inputTemplate":{"keywords":"{{query}}","location":"{{location}}","maxItems":"{{limit}}"}}]
JOB_DISCOVERY_APIFY_ACTORS=[]
# Search API credentials. SerpApi remains enabled as a fallback in `primary` mode.
SERPAPI_API_KEY=replace_me
ADZUNA_APP_ID=replace_me
ADZUNA_APP_KEY=replace_me
# Optional public ATS discovery sources (company board/site tokens, comma separated).
JOB_AGENT_GREENHOUSE_BOARDS=
JOB_AGENT_LEVER_SITES=
# Approved Workday public CXS sites. Hosts are restricted to *.myworkdayjobs.com.
# JOB_DISCOVERY_WORKDAY_SITES=[{"tenant":"company","site":"External","host":"company.wd5.myworkdayjobs.com","company":"Company Name","priority":12}]
JOB_DISCOVERY_WORKDAY_SITES=[]
# Optional direct vacancy hosts allowed for server-side verification. HTTPS and public DNS are still enforced.
JOB_AGENT_VERIFICATION_HOSTS=
# Optional model and observability configuration.
JOB_AGENT_MODEL=openai/gpt-5.4-mini
SERPAPI_ESTIMATED_COST_PER_SEARCH_USD=0

# Career Intelligence providers and refresh controls
CRON_SECRET=replace_with_a_long_random_value
ADZUNA_MAX_CALLS_PER_RUN=60
ADZUNA_MAX_RESULTS_PER_ITEM=100
INTELLIGENCE_REFRESH_ENABLED=false
