# Supabase server-side configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Public, RLS-limited key used only to read published Career content.
SUPABASE_ANON_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Resend server-side configuration
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=AI Career OS <hello@example.com>

# Public commercial/legal identity — required before paid B2C checkout is enabled.
# Verified operator defaults are defined in src/lib/legal.ts for legal name, registered address,
# complaint address and Hungarian tax number. Environment values may override those defaults.
NEXT_PUBLIC_LEGAL_ENTITY_NAME=Tayyebialashti Yaser e.v.
NEXT_PUBLIC_TRADING_NAME=AI Career OS
NEXT_PUBLIC_REGISTERED_ADDRESS=1143 Budapest, Gizella út 35, Hungary
# Required for Hungarian individual entrepreneurs: EVNY "nyilvántartási szám". Do not use the tax number here.
NEXT_PUBLIC_COMPANY_REGISTRATION_NUMBER=
NEXT_PUBLIC_VAT_NUMBER=48332376-1-42
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_COMPLAINT_ADDRESS=1143 Budapest, Gizella út 35, Hungary
NEXT_PUBLIC_DISPUTE_RESOLUTION_BODY=
NEXT_PUBLIC_DISPUTE_RESOLUTION_URL=

# Public site / consent-controlled analytics
NEXT_PUBLIC_SITE_URL=https://ai-positions-roadmap.vercel.app
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Career Intelligence providers and refresh controls
ADZUNA_APP_ID=replace_me
ADZUNA_APP_KEY=replace_me
CRON_SECRET=replace_with_a_long_random_value
ADZUNA_MAX_CALLS_PER_RUN=60
ADZUNA_MAX_RESULTS_PER_ITEM=100
INTELLIGENCE_REFRESH_ENABLED=false
