# Supabase server-side configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Public, RLS-limited key used only to read published Career content.
SUPABASE_ANON_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Resend server-side configuration
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=AI Career Roadmaps <hello@example.com>

# Career Intelligence providers and refresh controls
ADZUNA_APP_ID=replace_me
ADZUNA_APP_KEY=replace_me
CRON_SECRET=replace_with_a_long_random_value
ADZUNA_MAX_CALLS_PER_RUN=60
ADZUNA_MAX_RESULTS_PER_ITEM=100
INTELLIGENCE_REFRESH_ENABLED=false
